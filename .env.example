# Application Settings
APP_NAME="Gamified Life-Agent Engine"
SECRET_KEY="your-secret-key-here"
DEBUG=true

# OpenTelemetry：本地开发建议 true，避免 Flask 热重载时 SDK 已 shutdown 仍触发 LLM/LangChain 回调报错
OTEL_SDK_DISABLED=true

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DB=gamified_life

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 选填：Redis ACL 用户名（Redis 6+）
REDIS_USERNAME=
# 选填：Redis 密码
REDIS_PASSWORD=
# 选填：若你已提供完整 URL（如 rediss://user:pass@host:6380/0），可直接覆盖上面三项
# REDIS_URL=
# Checkpoint Redis 连接超时（秒），避免网络异常导致对话长时间卡住
REDIS_SOCKET_CONNECT_TIMEOUT_SEC=3.0
# Checkpoint Redis 命令超时（秒）
REDIS_SOCKET_TIMEOUT_SEC=3.0

# LLM (LiteLLM)
DEFAULT_MODEL=gpt-4
FALLBACK_MODELS=gpt-3.5-turbo,claude-3-opus
LITELLM_API_KEY=your-api-key-here
LITELLM_BASE_URL=

# MCP Server
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001
# 外部 MCP（可选）：JSON 对象，键为服务名，值为 MultiServerMCPClient server 配置
# 示例:
# MCP_EXTERNAL_SERVERS_JSON={"remote_docs":{"transport":"streamable_http","url":"http://localhost:9000/mcp"}}
MCP_EXTERNAL_SERVERS_JSON=

# Flask
HOST=0.0.0.0
PORT=5000
# 是否在 DEBUG 下启用热重载；Windows 默认建议 false（见 app.config.FLASK_USE_RELOADER）
# FLASK_USE_RELOADER=false

# Let's Encrypt
LE_CERTBOT_ENABLED=0
LE_DOMAIN=example.com
LE_ADDITIONAL_DOMAINS=
LE_EMAIL=ops@example.com
LE_STAGING=1

# Game Mechanics
BASE_XP_PER_TASK=100
DROP_RATE_BASE=0.1
